{
  "mcpServers": {
    "tauri": {
      "command": "npx",
      "args": [
        "-y",
        "@hypothesi/tauri-mcp-server"
      ]
    },
    "grafana": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GRAFANA_URL": "http://localhost:3000"
      }
    },
    "tempo": {
      "url": "http://localhost:3200/api/mcp"
    },
    // CDP for VS Code Electron / webviews. Port 9222 must match
    // --remote-debugging-port=9222 on `pnpm vscode:open` (root package.json).
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--experimental-include-all-pages"
      ]
    }
  }
}
