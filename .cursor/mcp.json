{
  "mcpServers": {
    "tauri": {
      "command": "npx",
      "args": [
        "-y",
        "@hypothesi/tauri-mcp-server"
      ]
    },
    "grafana": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GRAFANA_URL": "http://localhost:3000"
      }
    },
    "tempo": {
      "url": "http://localhost:3200/api/mcp"
    }
  }
}
