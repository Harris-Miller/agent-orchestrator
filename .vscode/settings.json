{
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "search.exclude": {
    "**/.agents": true,
    "**/.claude": true,
    "**/.cursor": true,
    "**/.turbo": true
  },
  "files.watcherExclude": {
    "**/.agents/**": true,
    "**/.claude/**": true,
    "**/.cursor/**": true,
    "**/.turbo/**": true
  },
  "files.associations": {
    ".mcp.json": "jsonc",
    "turbo.json": "jsonc"
  }
}
