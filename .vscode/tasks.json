{
  "version": "2.0.0",
  "tasks": [
    {
      // F5 "Run Extension": watch first, then spawn EDH with Node inspect paused.
      "label": "vscode: debug",
      "dependsOn": ["vscode: watch", "vscode: edh-inspect"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      // EDH = Extension Development Host. Opens a separate `code` window with this
      // extension loaded, paused on --inspect-brk-extensions until launch.json attaches.
      // Port 5870 must match launch.json "Run Extension" attach port.
      "label": "vscode: edh-inspect",
      "type": "shell",
      "command": "env -u VSCODE_IPC_HOOK_CLI -u VSCODE_IPC_HOOK code --extensionDevelopmentPath=\"${workspaceFolder}/apps/vscode\" --inspect-brk-extensions=5870",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "vscode-watch"
      }
    },
    {
      "label": "vscode: watch",
      "dependsOn": ["vscode: watch:main", "vscode: watch:renderer"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "vscode: watch:main",
      "type": "npm",
      "script": "watch:main",
      "path": "apps/vscode/",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tsdown",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Build complete|Rebuilt in)"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "vscode-watch"
      }
    },
    {
      "label": "vscode: watch:renderer",
      "type": "npm",
      "script": "watch:renderer",
      "path": "apps/vscode/",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ready in \\d+ m?s"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "vscode-watch"
      }
    }
  ]
}
