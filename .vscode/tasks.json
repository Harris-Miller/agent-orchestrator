{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vscode-extension: watch",
      "type": "npm",
      "script": "watch",
      "path": "apps/vscode-extension/",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "build started\\.\\.\\.",
          "endsPattern": "built in \\d+ms\\."
        }
      },
      "presentation": {
        "reveal": "silent"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
