{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vscode-extension: watch",
      "dependsOn": ["vscode-extension: watch:main", "vscode-extension: watch:renderer"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "vscode-extension: watch:main",
      "type": "npm",
      "script": "watch:main",
      "path": "apps/vscode-extension/",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tsdown",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Build complete|Rebuilt in)"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "vscode-extension-watch"
      }
    },
    {
      "label": "vscode-extension: watch:renderer",
      "type": "npm",
      "script": "watch:renderer",
      "path": "apps/vscode-extension/",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "build started\\.\\.\\.",
          "endsPattern": "built in \\d+ms\\."
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "vscode-extension-watch"
      }
    }
  ]
}
