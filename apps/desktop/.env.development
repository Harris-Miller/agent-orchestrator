OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Product analytics to a local PostHog (docs/local-posthog.md). The token is not here: put POSTHOG_PROJECT_TOKEN in the
# gitignored .env next to this file (read at build time; empty or unset = analytics off).
POSTHOG_HOST=http://localhost:8000
HOA_ANTIGRAVITY_BETA=true
HOA_CURSOR_BETA=false
