{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (app dirs via fs:default; recursive $HOME read/write for Agent Harness; exists on common PATH bins)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "mcp-bridge:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    "opener:default",
    "fs:default",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    "fs:allow-temp-write-recursive",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "/opt/homebrew/**" },
        { "path": "/usr/local/**" },
        { "path": "/usr/bin/**" },
        { "path": "/bin/**" }
      ]
    },
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:4318/**" },
        { "url": "http://localhost:4318/**" }
      ]
    },
    "window-state:default",
    "shell:default",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "cmd": "bun",
          "name": "bun"
        },
        {
          "args": true,
          "cmd": "claude",
          "name": "claude"
        },
        {
          "args": true,
          "cmd": "cmd",
          "name": "cmd"
        },
        {
          "args": true,
          "cmd": "codex",
          "name": "codex"
        },
        {
          "args": true,
          "cmd": "find",
          "name": "find"
        },
        {
          "args": true,
          "cmd": "gemini",
          "name": "gemini"
        },
        {
          "args": true,
          "cmd": "node",
          "name": "node"
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "args": true,
          "cmd": "bun",
          "name": "bun"
        },
        {
          "args": true,
          "cmd": "claude",
          "name": "claude"
        },
        {
          "args": true,
          "cmd": "cmd",
          "name": "cmd"
        },
        {
          "args": true,
          "cmd": "codex",
          "name": "codex"
        },
        {
          "args": true,
          "cmd": "find",
          "name": "find"
        },
        {
          "args": true,
          "cmd": "gemini",
          "name": "gemini"
        },
        {
          "args": true,
          "cmd": "node",
          "name": "node"
        }
      ]
    }
  ]
}
