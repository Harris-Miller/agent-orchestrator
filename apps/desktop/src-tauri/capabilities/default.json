{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (app dirs via fs:default; recursive $HOME read/write for Agent Harness; exists on common PATH bins)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "mcp-bridge:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    "opener:default",
    "notification:default",
    "fs:default",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    "fs:allow-temp-write-recursive",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "/opt/homebrew/**" },
        { "path": "/usr/local/**" },
        { "path": "/usr/bin/**" },
        { "path": "/bin/**" },
        { "path": "/opt/local/**" },
        { "path": "C:/Windows/System32/**" },
        { "path": "C:/Program Files/**" },
        { "path": "C:/Program Files (x86)/**" },
        { "path": "C:/ProgramData/chocolatey/bin/**" },
        { "path": "$USERPROFILE/scoop/shims/**" },
        { "path": "$USERPROFILE/AppData/Local/Microsoft/WinGet/Links/**" },
        { "path": "$HOME/.local/bin/**" },
        { "path": "$HOME/bin/**" }
      ]
    },
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:4318/**" },
        { "url": "http://localhost:4318/**" },
        { "url": "http://127.0.0.1:8000/**" },
        { "url": "http://localhost:8000/**" },
        { "url": "https://dl.google.com/agy-extensions/**" },
        { "url": "https://raw.githubusercontent.com/agentclientprotocol/registry/main/antigravity-acp/agent.json" }
      ]
    },
    "window-state:default",
    "shell:default",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "args": true, "cmd": "bun", "name": "bun" },
        { "args": true, "cmd": "brew", "name": "brew" },
        { "args": true, "cmd": "choco", "name": "choco" },
        { "args": true, "cmd": "claude", "name": "claude" },
        { "args": true, "cmd": "codex", "name": "codex" },
        { "args": true, "cmd": "cursor-agent", "name": "cursor-agent" },
        { "args": true, "cmd": "fd", "name": "fd" },
        { "args": true, "cmd": "fdfind", "name": "fdfind" },
        { "args": true, "cmd": "chmod", "name": "chmod" },
        { "args": true, "cmd": "node", "name": "node" },
        { "args": true, "cmd": "port", "name": "port" },
        { "args": true, "cmd": "scoop", "name": "scoop" },
        { "args": true, "cmd": "unzip", "name": "unzip" },
        { "args": true, "cmd": "winget", "name": "winget" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "args": true, "cmd": "bun", "name": "bun" },
        { "args": true, "cmd": "brew", "name": "brew" },
        { "args": true, "cmd": "choco", "name": "choco" },
        { "args": true, "cmd": "claude", "name": "claude" },
        { "args": true, "cmd": "codex", "name": "codex" },
        { "args": true, "cmd": "cursor-agent", "name": "cursor-agent" },
        { "args": true, "cmd": "fd", "name": "fd" },
        { "args": true, "cmd": "fdfind", "name": "fdfind" },
        { "args": true, "cmd": "chmod", "name": "chmod" },
        { "args": true, "cmd": "node", "name": "node" },
        { "args": true, "cmd": "port", "name": "port" },
        { "args": true, "cmd": "scoop", "name": "scoop" },
        { "args": true, "cmd": "unzip", "name": "unzip" },
        { "args": true, "cmd": "winget", "name": "winget" },
        { "args": ["-i", "/bin/cat"], "cmd": "/usr/bin/caffeinate", "name": "/usr/bin/caffeinate" },
        {
          "args": [
            "--what=idle",
            "--who=Harness Orchestrating Agents",
            "--why=Agents are working",
            "--mode=block",
            "/bin/cat"
          ],
          "cmd": "/usr/bin/systemd-inhibit",
          "name": "/usr/bin/systemd-inhibit"
        },
        {
          "name": "provider-npm-version",
          "cmd": "npm",
          "args": ["--version"]
        },
        {
          "name": "provider-npm-view",
          "cmd": "npm",
          "args": ["view", { "validator": "^@agentclientprotocol/(claude-agent-acp|codex-acp)@latest$" }, "version"]
        },
        {
          "name": "provider-npm-install",
          "cmd": "npm",
          "args": [
            "install",
            "--prefix",
            {
              "validator": "^[^\\n]*/\\.hoa/providers/(claude-agent-acp|codex-acp)/runtime/[0-9A-Za-z][0-9A-Za-z._+-]*$"
            },
            "--omit=optional",
            "--ignore-scripts",
            {
              "validator": "^@agentclientprotocol/(claude-agent-acp|codex-acp)@[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
            }
          ]
        }
      ]
    }
  ]
}
