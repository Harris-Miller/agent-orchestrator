{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (app dirs via fs:default; recursive $HOME read/write for Agent Harness)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    "os:default",
    "shell:default",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "cmd": "bun",
          "name": "bun"
        },
        {
          "args": true,
          "cmd": "codex-acp",
          "name": "codex-acp"
        },
        {
          "args": true,
          "cmd": "claude-agent-acp",
          "name": "claude-agent-acp"
        },
        {
          "args": true,
          "cmd": "gemini",
          "name": "gemini"
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "args": true,
          "cmd": "bun",
          "name": "bun"
        },
        {
          "args": true,
          "cmd": "codex-acp",
          "name": "codex-acp"
        },
        {
          "args": true,
          "cmd": "claude-agent-acp",
          "name": "claude-agent-acp"
        },
        {
          "args": true,
          "cmd": "gemini",
          "name": "gemini"
        }
      ]
    }
  ]
}
