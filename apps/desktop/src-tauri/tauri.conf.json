{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-orchestrator",
  "version": "0.1.0",
  "identifier": "com.agent-orchestrator",
  "build": {
    "beforeDevCommand": "pnpm run materialize-acp-adapters && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run materialize-acp-adapters && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "agent-orchestrator",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../acp-adapter-resources/node_modules": "acp-adapter-resources/node_modules"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
