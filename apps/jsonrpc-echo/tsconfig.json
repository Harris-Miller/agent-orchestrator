{
  "extends": "@tooling/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": [
      "bun"
    ],
    // Bundler mode
    "moduleResolution": "bundler",
  },
  "include": [
    "src/**/*",
    "*.ts",
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
