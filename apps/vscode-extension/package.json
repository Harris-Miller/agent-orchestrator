{
  "name": "agent-orchestrator-vscode",
  "displayName": "Agent Orchestrator",
  "description": "Agent Orchestrator VS Code extension (local development scaffold).",
  "version": "0.0.1",
  "publisher": "harris-miller",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.cjs",
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsdown",
    "build:renderer": "vite build -c vite.webview.config.ts",
    "lint": "eslint . --max-warnings 0",
    "package": "pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "watch:main": "tsdown --watch",
    "watch:renderer": "vite build --watch -c vite.webview.config.ts"
  },
  "dependencies": {
    "effect": "catalog:",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tooling/eslint": "workspace:^",
    "@tooling/tsconfig": "workspace:^",
    "@tooling/vitest": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/vscode": "^1.100.0",
    "@vitejs/plugin-react": "catalog:",
    "@vscode/vsce": "^3.7.1",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentOrchestrator",
          "title": "Agent Orchestrator",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agentOrchestrator": [
        {
          "type": "webview",
          "id": "agentOrchestrator.sidebar",
          "name": "Agent Orchestrator"
        }
      ]
    },
    "commands": [
      {
        "command": "agentOrchestrator.helloWorld",
        "title": "Agent Orchestrator: Hello World"
      }
    ]
  }
}
