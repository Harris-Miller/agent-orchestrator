{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // vscode-extesions have direct access to node APIs, as well as the vscode APIs
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
