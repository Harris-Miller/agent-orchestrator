{
  "extends": ["//"],
  "tasks": {
    "materialize-acp-adapters": {
      "inputs": [
        "$TURBO_ROOT$/acp-adapter-resources/package.json",
        "$TURBO_ROOT$/acp-adapter-resources/pnpm-lock.yaml",
        "scripts/ensure-acp-adapter-symlink.js"
      ],
      "outputs": [
        "acp-adapter-resources"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "materialize-acp-adapters"
      ]
    },
    "watch:main": {
      "dependsOn": [
        "materialize-acp-adapters"
      ]
    }
  }
}
