{
  "name": "agent-orchestrator-vscode",
  "displayName": "Agent Orchestrator",
  "version": "0.0.1",
  "private": true,
  "description": "Agent Orchestrator VS Code extension (local development scaffold).",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Harris-Miller/agent-orchestrator.git"
  },
  "publisher": "harris-miller",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "vscode:prepublish": "pnpm run prepare-acp-adapters-for-package && pnpm run build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsdown",
    "build:renderer": "vite build",
    "lint": "oxlint . --deny-warnings",
    "materialize-acp-adapters": "node ./scripts/ensure-acp-adapter-symlink.js",
    "package": "pnpm run vscode:prepublish && vsce package --no-dependencies --allow-missing-repository",
    "prepare-acp-adapters-for-package": "pnpm --dir ../.. run install-acp-adapter-deps && node ./scripts/sync-acp-adapter-resources.js",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "test": "vitest run",
    "watch:main": "tsdown --watch",
    "watch:renderer": "vite"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@lib/ao-home": "workspace:^",
    "@lib/context-services-vscode-webview": "workspace:^",
    "@lib/ui": "workspace:^",
    "@mui/material": "catalog:",
    "@tanstack/react-router": "catalog:",
    "allotment": "catalog:",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tooling/oxlint": "workspace:^",
    "@tooling/tsconfig": "workspace:^",
    "@tooling/vitest": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/vscode": "^1.140.0",
    "@types/vscode-webview": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vscode/vsce": "^3.7.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentOrchestrator",
          "title": "Agent Orchestrator",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agentOrchestrator": [
        {
          "type": "webview",
          "id": "agentOrchestrator.sidebar",
          "name": "Agent Orchestrator"
        }
      ]
    },
    "commands": [
      {
        "command": "agentOrchestrator.helloWorld",
        "title": "Agent Orchestrator: Hello World"
      }
    ]
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.140.0"
  }
}
