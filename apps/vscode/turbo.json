{
  "extends": ["//"],
  "tasks": {
    "materialize-acp-adapters": {
      "dependsOn": ["//#install-acp-adapter-deps"],
      "inputs": ["scripts/ensure-acp-adapter-symlink.js"],
      "outputs": ["acp-adapter-resources"]
    },
    "build": {
      "dependsOn": ["^build", "materialize-acp-adapters"]
    },
