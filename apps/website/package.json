{
  "name": "@apps/website",
  "version": "0.0.0",
  "private": true,
  "description": "HOA marketing + docs site (VitePress)",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "vitepress dev --port 5183",
    "lint": "pnpm run lint:check --fix",
    "lint:check": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "preview": "vite preview --outDir dist --port 4173 --strictPort",
    "start": "pnpm run build && pnpm run preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tooling/oxlint": "workspace:^",
    "@tooling/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:"
  }
}
