{
  "name": "@apps/website",
  "version": "0.1.0",
  "private": true,
  "description": "PROTOTYPE (#435): three VitePress variants of the HOA marketing + docs site, sharing one content/ tree",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev:a": "WEBSITE_PROTOTYPE=1 vitepress dev variants/a --port 5181",
    "dev:b": "WEBSITE_PROTOTYPE=1 vitepress dev variants/b --port 5182",
    "dev:c": "WEBSITE_PROTOTYPE=1 vitepress dev variants/c --port 5183",
    "lint": "pnpm run lint:check --fix",
    "lint:check": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "preview": "vite preview --outDir dist --port 4173 --strictPort",
    "prototype": "WEBSITE_PROTOTYPE=1 pnpm run build && pnpm run preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tooling/oxlint": "workspace:^",
    "@tooling/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:"
  }
}
