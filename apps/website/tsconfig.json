{
  "extends": "@tooling/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["shared/**/*.ts", "scripts/**/*.ts", "variants/*/.vitepress/**/*.ts", "variants/*/.vitepress/**/*.mts"],
  "exclude": ["node_modules", "dist", "**/.vitepress/cache"]
}
