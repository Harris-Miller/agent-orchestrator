{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob '**/.turbo' '**/coverage' 'apps/*/dist'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo run lint",
    "local-ci": "pnpm run format:check && turbo run typecheck lint test",
    "prepare": "effect-tsgo patch",
    "tauri:dev": "turbo run tauri:dev --filter=@apps/desktop",
    "tauri:build": "turbo run tauri:build --filter=@apps/desktop",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "vscode:build": "turbo run build --filter=agent-orchestrator-vscode",
    "vscode:dev": "turbo run watch:main watch:renderer --filter=agent-orchestrator-vscode",
    "vscode:open": "code --remote-debugging-port=9222 --extensionDevelopmentPath=\"$PWD/apps/vscode\""
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "catalog:",
    "@agentclientprotocol/codex-acp": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
