{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "clean": "rimraf --glob '**/.turbo' '**/coverage' 'apps/*/dist' 'apps/*/acp-adapter-resources'",
    "lint": "turbo run lint",
    "local-ci": "turbo run typecheck lint test",
    "install-acp-adapter-deps": "pnpm --dir acp-adapter-resources install --frozen-lockfile --prod",
    "prepare": "effect-language-service patch",
    "tauri:dev": "turbo run tauri:dev --filter=@apps/desktop",
    "tauri:build": "turbo run tauri:build --filter=@apps/desktop",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "vscode:watch": "turbo run watch:main watch:renderer --filter=agent-orchestrator-vscode",
    "vscode:build": "turbo run build --filter=agent-orchestrator-vscode",
    "vscode:dev": "code --remote-debugging-port=9222 --extensionDevelopmentPath=\"$PWD/apps/vscode\""
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
