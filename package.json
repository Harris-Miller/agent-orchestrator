{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "clean": "rimraf --glob '**/.turbo' '**/coverage' 'apps/*/dist'",
    "lint": "turbo run lint",
    "local-ci": "turbo run typecheck lint test",
    "materialize-acp-adapters": "pnpm --dir acp-adapter-resources install --frozen-lockfile --prod",
    "prepare": "effect-language-service patch",
    "tauri:dev": "turbo run tauri:dev --filter=@apps/desktop",
    "tauri:build": "turbo run tauri:build --filter=@apps/desktop",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "watch:vscode": "turbo run watch:main watch:renderer --filter=agent-orchestrator-vscode",
    "vscode:build": "turbo run build --filter=agent-orchestrator-vscode",
    "vscode:dev": "code --extensionDevelopmentPath=\"$PWD/apps/vscode-extension\""
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
