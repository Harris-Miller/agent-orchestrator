{
  "name": "hoa",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob '**/.turbo' '**/coverage' 'apps/*/dist' '**/node_modules/.tmp'",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "hub:start": "pnpm --filter=@lib/hub start",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "local-ci": "pnpm run fmt:check && turbo run typecheck lint:check test",
    "prepare": "effect-tsgo patch",
    "tauri:build": "turbo run tauri:build --filter=@apps/desktop",
    "tauri:dev": "turbo run tauri:dev --filter=@apps/desktop",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck-root typecheck",
    "typecheck-root": "tsc --noEmit",
    "vscode:build": "turbo run build --filter=hoa-vscode",
    "vscode:dev": "turbo run watch:main watch:renderer --filter=hoa-vscode",
    "vscode:open": "code --remote-debugging-port=9222 --extensionDevelopmentPath=\"$PWD/apps/vscode\"",
    "website": "pnpm --filter=@apps/website run start"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "catalog:",
    "@agentclientprotocol/codex-acp": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
