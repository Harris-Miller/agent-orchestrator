{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "//#format:check": {
      // caching everything that oxfmt touches takes significantly longer that running format:check
      // so just don't cache
      "cache": false
    },
    "//#install-acp-adapter-deps": {
      "inputs": ["acp-adapter-resources/package.json", "acp-adapter-resources/pnpm-lock.yaml"],
      "outputs": ["acp-adapter-resources/node_modules/**", "acp-adapter-resources/vendor/**"]
    },
    "materialize-acp-adapters": {},
    "test": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch:main": {
      "cache": false,
      "persistent": true
    },
    "watch:renderer": {
      "cache": false,
      "persistent": true
    },
    "tauri:dev": {
      "cache": false,
      "passThroughEnv": ["CURSOR_API_KEY", "CURSOR_AUTH_TOKEN"],
      "persistent": true
    },
    "tauri:build": {
      "outputs": [
        "src-tauri/target/release/CACHEDIR.TAG",
        "src-tauri/target/release/.rustc_info.json",
        "src-tauri/target/release"
      ]
    }
  }
}
