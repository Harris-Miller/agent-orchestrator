{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": true,
  "tasks": {
    "//#typecheck-root": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "package": {
      "cache": false,
      "outputs": ["hoa-vscode.vsix"]
    },
    "test": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch:main": {
      "cache": false,
      "persistent": true
    },
    "watch:renderer": {
      "cache": false,
      "persistent": true
    },
    "tauri:dev": {
      "cache": false,
      "passThroughEnv": ["CURSOR_API_KEY", "CURSOR_AUTH_TOKEN"],
      "persistent": true
    },
    "tauri:build": {
      "dependsOn": ["hoa-vscode#package"],
      "outputs": [
        "src-tauri/target/release/CACHEDIR.TAG",
        "src-tauri/target/release/.rustc_info.json",
        "src-tauri/target/release"
      ]
    }
  }
}
