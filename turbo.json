{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {},
    "test": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch:main": {
      "cache": false,
      "persistent": true
    },
    "watch:renderer": {
      "cache": false,
      "persistent": true
    },
    "tauri:dev": {
      "cache": false,
      "persistent": true
    },
    "tauri:build": {
      "outputs": [
        "src-tauri/target/release/CACHEDIR.TAG",
        "src-tauri/target/release/.rustc_info.json",
        "src-tauri/target/release"
      ]
    }
  }
}
