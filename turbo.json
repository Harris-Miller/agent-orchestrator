{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ]
    },
    "test:ci": {
      "dependsOn": [
        "transit"
      ],
      "outputs": [
        "coverage/blob/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "tauri:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
